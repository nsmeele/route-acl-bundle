{% extends nsmeele_route_acl_layout %}

{% block title %}Route coverage{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>Route coverage</h1>
    </header>

    <section class="panel">
        <h2>Routes without a permission</h2>
        <p class="muted">These routes match <code>{{ protected_path }}</code> but have no <code>#[AclAction]</code>, so only roles with full access can open them.</p>
        {% if tree.unmappedRoutes is empty %}
            <p>None. Every protected route has a permission.</p>
        {% else %}
            <ul class="key-list">
                {% for route in tree.unmappedRoutes %}<li><code>{{ route }}</code></li>{% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if orphaned is not empty %}
        <section class="panel">
            <h2>Permissions that no longer exist</h2>
            <p class="muted">Still stored on roles, but no longer in the code. They have no effect and disappear when the role is saved.</p>
            <table class="table">
                <thead><tr><th>Permission</th><th>Roles</th></tr></thead>
                <tbody>
                    {% for key, labels in orphaned %}
                        <tr><td><code>{{ key }}</code></td><td>{{ labels|join(', ') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    {% endif %}

    <section class="panel">
        <h2>Permissions and their routes</h2>
        <table class="table">
            <thead><tr><th>Permission</th><th>Routes</th></tr></thead>
            <tbody>
                {% for key, permission in tree.permissions %}
                    <tr>
                        <td>{{ tree.describe(key) }}</td>
                        <td>{% for route in permission.routes %}<code>{{ route }}</code>{{ not loop.last ? ' ' }}{% endfor %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2" class="muted">No permissions yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
