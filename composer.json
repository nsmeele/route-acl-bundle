{
    "name": "nsmeele/route-acl-bundle",
    "description": "Route-based access control with a hierarchical permission tree and database roles that plug into Symfony's role hierarchy",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.13 || ^3.4",
        "doctrine/orm": "^3.8",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "twig/twig": "^3.21"
    },
    "autoload": {
        "psr-4": {
            "Nsmeele\\RouteAclBundle\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.4"
    }
}
